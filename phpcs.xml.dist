<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="YouTube MCP">
    <description>PSR-12 checks; PHP-CS-Fixer adds the PER Coding Style rules.</description>
    <arg name="extensions" value="php"/>
    <arg value="p"/>
    <file>src</file>
    <file>tests</file>
    <file>bin</file>
    <file>public</file>
    <file>.php-cs-fixer.dist.php</file>
    <exclude-pattern>*/HUMANS.md</exclude-pattern>
    <rule ref="PSR12"/>
</ruleset>
