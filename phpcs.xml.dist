<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="YouTube MCP">
    <description>PER Coding Style, using the shared PHP-CS-Fixer preset through a read-only sniff.</description>
    <arg name="extensions" value="php"/>
    <arg value="p"/>
    <file>src</file>
    <file>tests</file>
    <file>bin</file>
    <file>public</file>
    <file>.php-cs-fixer.dist.php</file>
    <exclude-pattern>*/HUMANS.md</exclude-pattern>
    <rule ref="./src/Quality/Sniffs/Formatting/PerCodingStyleSniff.php"/>
</ruleset>
