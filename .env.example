APP_URL=https://music.example.com
STORAGE_PATH=var
APP_KEY=
GOOGLE_CLIENT_ID=
# Connecting Google requests youtube.force-ssl plus youtube for Music. Existing grants require fresh browser consent after upgrading.
GOOGLE_CLIENT_SECRET=
# Optional country code for Music responses, e.g. NL. Empty uses upstream default.
MUSIC_LOCATION=
# Optional Music web client version override; empty discovers the current version from the public Music homepage.
MUSIC_CLIENT_VERSION=
# Optional separate Google OAuth client of type TVs and Limited Input devices for Music.
# Keep GOOGLE_CLIENT_* as the Web application client used by sign-in and official YouTube tools.
# Optional Music browser sessions use the private dashboard and encrypted storage,
# never environment variables for cookies; apply migration 004 before connecting.
MUSIC_OAUTH_CLIENT_ID=
MUSIC_OAUTH_CLIENT_SECRET=
# Verified Google email addresses; empty denies new registrations.
ALLOWED_EMAILS=you@example.com
ALLOW_REGISTRATION=false
OPERATION_RETENTION_DAYS=7
COOKIE_SECURE=true
# Comma-separated OAuth callback URLs permitted for registered clients.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform/oauth/callback
