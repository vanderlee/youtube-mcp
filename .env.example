APP_URL=https://music.example.com
STORAGE_PATH=var
# Seconds for additional read-only metadata/channel/comment caching; 0 disables this cache.
# Mutation validation remains fresh. Existing search/list tools retain their explicit TTLs.
API_READ_CACHE_TTL=30
# Docker Compose overrides STORAGE_PATH with /app/var in its persistent local volume.
# Creator files are staged privately under STORAGE_PATH/media, expire after 24h,
# and are cleaned by the existing cleanup command. Upload limits are included in the Docker image;
# configure them separately for Plesk. See docs/DOCKER.md for container setup and maintenance.
APP_KEY=
GOOGLE_CLIENT_ID=
# Google OAuth configuration failures preserve connections; repair configuration before reconnecting users.
GOOGLE_CLIENT_SECRET=
# Verified Google email addresses; empty denies new registrations.
ALLOWED_EMAILS=you@example.com
ALLOW_REGISTRATION=false
OPERATION_RETENTION_DAYS=7
COOKIE_SECURE=true
# Server-side browser authentication expiry (positive seconds).
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
# Comma-separated OAuth callback URLs permitted for registered clients.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform/oauth/callback
