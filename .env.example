APP_URL=https://music.example.com
STORAGE_PATH=var
APP_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verified Google email addresses; empty denies new registrations.
ALLOWED_EMAILS=you@example.com
ALLOW_REGISTRATION=false
QUOTA_GENERAL=10000
QUOTA_SEARCH=100
QUOTA_HEADROOM=0.10
QUOTA_RECOVERY_RESERVE=200
# Optional current method-cost overrides as JSON. Leave empty to use defaults.
QUOTA_METHOD_COSTS='{}'
USER_QUOTA_GENERAL=1500
USER_QUOTA_SEARCH=10
MCP_CALLS_PER_MINUTE=10
OPERATION_RETENTION_DAYS=7
COOKIE_SECURE=true
# Comma-separated OAuth callback URLs permitted for registered clients.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform/oauth/callback
