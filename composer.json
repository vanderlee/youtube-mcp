{
  "name": "youtube-mcp/service",
  "description": "Multi-user YouTube playlist MCP service for PHP-FPM",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-sodium": "*",
    "ext-session": "*",
    "mcp/sdk": "^0.8.1",
    "league/oauth2-server": "^9.4",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "psr/simple-cache": "^3.0",
    "symfony/cache": "^6.4",
    "vlucas/phpdotenv": "^5.6",
    "firebase/php-jwt": "^7.0"
  },
  "require-dev": {"phpunit/phpunit": "^10.5"},
  "autoload": {"psr-4": {"YouTubeMcp\\": "src/"}},
  "autoload-dev": {"psr-4": {"YouTubeMcp\\Tests\\": "tests/"}},
  "scripts": {"test": "phpunit", "migrate": "php bin/console.php migrate"},
  "config": {"allow-plugins": {"php-http/discovery": false}, "sort-packages": true}
}
